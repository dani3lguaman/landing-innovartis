# "Aterrizamos tus ideas" (/aterriza). Copiar a .env.local para probar en local.
# NUNCA subir claves al repo: en producción se escriben en Vercel (Project → Settings → Environment Variables).

# --- Obligatoria para generar briefs reales ---
# La misma clave del asistente de WhatsApp. Sin ella, en desarrollo se usa un brief simulado
# y en producción el cliente ve "el equipo le entrega su plan en 24 h" (el lead no se pierde).
ANTHROPIC_API_KEY=

# Modelo (opcional). Por defecto claude-opus-5-5; alternativa más barata: claude-sonnet-5-5.
BRIEF_MODEL=claude-opus-5-5

# Forzar el brief simulado aunque haya clave (pruebas sin gastar): 1 = sí.
BRIEF_MOCK=

# --- Guardado de briefs (Upstash Redis, integración de Vercel) ---
# Sin estas variables los briefs no se guardan (solo en memoria del proceso) y el enlace /aterriza/<id> no sirve.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# (también se aceptan UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN)

# --- Aviso por correo al equipo (Resend) ---
# Sin clave no se envía correo: el resumen queda en los registros del servidor.
RESEND_API_KEY=
# A quién avisar (separados por coma). Por defecto innuevate@gmail.com.
BRIEF_CORREOS_AVISO=innuevate@gmail.com
# Remitente: requiere el dominio innovartis.lat verificado en Resend (3 registros DNS).
# Sin dominio verificado, Resend solo deja enviar desde onboarding@resend.dev al correo dueño de la cuenta.
BRIEF_CORREO_REMITENTE=Sistema InnovArtis <planes@innovartis.lat>

# --- Límites anti-abuso ---
BRIEF_LIMITE_IP_DIA=3
BRIEF_LIMITE_WHATSAPP_DIA=3
BRIEF_TOPE_MES=300

# --- HubSpot (Forms API pública, sin clave). 1 = crear/actualizar el contacto con origen "Aterriza". ---
BRIEF_HUBSPOT=

# URL pública para los enlaces del correo (por defecto https://innovartis.lat; en la vista previa de Vercel, su URL).
NEXT_PUBLIC_SITE_URL=
